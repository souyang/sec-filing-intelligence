{
  "name": "sec-alphaops",
  "private": true,
  "scripts": {
    "dev:web": "pnpm --filter @sec-alphaops/web dev",
    "dev:api": "cd apps/api && uv run uvicorn sec_alphaops_api.main:app --reload --host 0.0.0.0 --port 8000",
    "build:web": "pnpm --filter @sec-alphaops/web build",
    "lint:web": "pnpm --filter @sec-alphaops/web lint",
    "typecheck:web": "pnpm --filter @sec-alphaops/web typecheck",
    "generate:contracts": "pnpm --filter @sec-alphaops/contracts generate",
    "check:contracts": "pnpm --filter @sec-alphaops/contracts check"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  },
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20"
  }
}
