# =============================================================================
# SEC AlphaOps — Environment Variables
# Copy to .env for local dev: cp .env.example .env
# =============================================================================

# --- General ---
APP_ENV=development
# openai | ollama (local, no API key)
LLM_PROVIDER=ollama

# --- Postgres (required: API + worker) ---
DATABASE_URL=postgresql+asyncpg://alphaops:alphaops@localhost:5432/alphaops
# Optional read replica for dashboard queries
DATABASE_READ_URL=

# --- Redis (required: SSE streams, optional LangGraph cache) ---
REDIS_URL=redis://localhost:6379/0

# --- Temporal (required: API starts workflows, worker polls queue) ---
# Local Docker:
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=sec-alphaops
# TEMPORAL_API_KEY=

# Temporal Cloud (uncomment; leave API key empty for local):
# TEMPORAL_ADDRESS=sec-alphaops.bbqmu.tmprl.cloud:7233
# TEMPORAL_NAMESPACE=sec-alphaops.bbqmu
# TEMPORAL_API_KEY=your-temporal-cloud-api-key

# --- SEC EDGAR (required for live downloads; format: "CompanyName email@domain.com") ---
SEC_EDGAR_IDENTITY=YourCompany you@example.com

# --- OpenAI (required when LLM_PROVIDER=openai) ---
OPENAI_API_KEY=

# --- Ollama (local LLM when LLM_PROVIDER=ollama) ---
OLLAMA_BASE_URL=http://localhost:11434

# --- Cloudflare R2 (required in production on Render; optional locally) ---
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_BUCKET=sec-alphaops-cache
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# --- API CORS (required in production: Vercel frontend origin) ---
ALLOWED_ORIGINS=http://localhost:3000

# --- Frontend (apps/web) — public, baked at build time on Vercel ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_SSE_URL=http://localhost:8000/sse
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-a-long-random-string

# --- Contract codegen (dev/CI only) ---
OPENAPI_URL=http://localhost:8000/openapi.json

# =============================================================================
# Production-only (set in Render / Vercel / GitHub Secrets)
# =============================================================================
# RENDER_API_DEPLOY_HOOK_URL=
# RENDER_WORKER_DEPLOY_HOOK_URL=
# VERCEL_TOKEN=
# VERCEL_ORG_ID=
# VERCEL_PROJECT_ID=
